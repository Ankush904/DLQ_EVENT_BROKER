, "logic_version": 7, "ai_flow_active": true, "use_basic_flow": true, "inference_threshold": 30, "non_detailed_reasons": {"category_mapping": [{"description": "if no conversation done in between the sales person & the student for continuously 30 second of the call or if no conversation has happened at all, select this category", "category_name": "BLANK CALL", "custom_evaluator": "BLANK_CALL_EVALUATOR"}, {"description": "Select this category if any of the following conditions apply:\n- The agent lacks salutation, gives their own name , compnay's name  i.e. Toprankers and confirm's the customer's name\n- The agent omits basic greetings and does not clearly state the purpose of the call.\n- The agent immediately pitches the product without engaging in a meaningful discussion with the customer.\n- The agent attempts to create a customer need without first understanding the customer\u2019s requirements and building rapport.\n- The customer expresses dissatisfaction or unhappiness with the responses provided, and the agent argues with the customer.\n- The agent does not maintain a serious tone.\n- The agent creates a sense of urgency at the beginning of the call (e.g., offering a limited-time discount, mentioning that a batch has started or is starting soon, stating there are limited seats, or emphasizing a shortened preparation time).\n- The agent directly asks the customer to join or enroll in a batch at the beginning of the call.\nThe agent lacks professionalism (e.g., being rude, abusive, laughing inappropriately, cross-talking, forcefully disconnecting the call, or placing the call on mute or hold without prior notification).", "category_name": "POOR PITCH"}, {"description": "Select this category under any of the following conditions:\n\n-The customer is not preparing for any exams.\n-The student cannot afford to enroll in the batch due to financial constraints.\n-The student perceives the product's price as high compared to other platforms.\n-The student is not satisfied with our product and services.\n-The student does not wish to enroll for any reason at the present time.\n-The student disconnects the call after listening to the Toprankers advertisement.\n-The student requests not to be called again.\n- If student use rude language and abruptly cut the call\n- If student says that it's the wrong number", "category_name": "DISINTERESTED CX"}, {"description": "Select this category if any of the following conditions apply:\n-The student is currently busy.\n-The student is out of station.\n-Someone else answered the call.\n-The student needs to discuss the product with their parents before enrolling.\n-There is difficulty in understanding between the speakers.\n-Confirming the best time for a callback.", "category_name": "Callback/Followup"}, {"description": "Conversations where no substantive or relevant information is exchanged. This may include long pauses or disjoined exchanges", "category_name": "Meaningless Conversations"}, {"description": "Select this category if there are communication difficulties due to language differences or other similar issues", "category_name": "Linguistic Barrier"}, {"description": "Select this category if the conversation had begun but seems to have ended abruptly in the middle of a conversation.", "category_name": "Abrupt End"}]}, "cost_reduction_active": true, "applicable_crm_statuses": []}, "created_at": "2025-02-17T07:39:48.474Z", "updated_at": "2026-05-01T11:05:30.894Z"}, {"id": 35321, "org_id": 476, "workspace_id": 616, "feature": "WORKSPACE_INSIGHTS", "enabled": true, "meta": {}, "created_at": "2025-11-14T14:13:30.276Z", "updated_at": "2026-04-20T13:52:10.947Z"}], "workspace_audit_avg": null, "user_audit_avg": null, "is_filtered_batch": true, "should_skip_audit": false}, "skip_transcription": true}}